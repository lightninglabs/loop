diff --git a/rest/script_key_test.go b/rest/script_key_test.go
new file mode 100644
index 0000000..88fb752
--- /dev/null
+++ b/rest/script_key_test.go
@@ -0,0 +1,52 @@
+package rest
+
+import (
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	tapsdk "github.com/lightninglabs/tap-sdk"
+	"github.com/lightninglabs/tap-sdk/macaroon"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDeclareScriptKeyEncoding(t *testing.T) {
+	t.Parallel()
+
+	key, err := tapsdk.ParsePubKey(restTestPubKey)
+	require.NoError(t, err)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter,
+		r *http.Request) {
+
+		var request struct {
+			ScriptKey *jsonScriptKey `json:"script_key"`
+		}
+		if !assert.NoError(t, json.NewDecoder(r.Body).Decode(&request)) ||
+			!assert.NotNil(t, request.ScriptKey) {
+
+			return
+		}
+		assert.Equal(t, hex.EncodeToString(key[1:]), request.ScriptKey.PubKey)
+		if assert.NotNil(t, request.ScriptKey.KeyDesc) {
+			assert.Equal(t, hex.EncodeToString(key[:]),
+				request.ScriptKey.KeyDesc.RawKeyBytes)
+		}
+		assert.NoError(t, json.NewEncoder(w).Encode(request))
+	}))
+	defer srv.Close()
+	client := newWalletKitClient(&transport{
+		baseURL: srv.URL, client: srv.Client(), timeout: time.Second,
+		macaroons: macaroon.Pouch{},
+	})
+	_, err = client.DeclareScriptKey(t.Context(), &tapsdk.DeclareScriptKeyRequest{
+		ScriptKey: tapsdk.ScriptKey{
+			PubKey:  key,
+			KeyDesc: tapsdk.KeyDescriptor{RawKeyBytes: key},
+		},
+	})
+	require.NoError(t, err)
+}
