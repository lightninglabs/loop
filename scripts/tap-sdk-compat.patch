+package tapsdk
+
+import (
+	"testing"
+
+	"github.com/lightninglabs/taproot-assets/proof"
+	"github.com/stretchr/testify/require"
+)
+
+// TestCustomAnchorActivationEvidence binds the compatibility adapter to the
+// evidence required by released tapd for new transitions.
+func TestCustomAnchorActivationEvidence(t *testing.T) {
+	_, base, key := newAssetProofPathBase(t)
+	split := newAssetProofPathSplitTransition(t, base, key)
+	require.NoError(t, checkActivationEvidence(split))
+	pkg := newCustomAnchorTestFixture(t).sealed
+	regular, err := proof.Decode(pkg.ProofUpdates[0].ProofBlob)
+	require.NoError(t, err)
+	require.Equal(t, proof.TransitionV1, regular.Version)
+	require.NoError(t, checkActivationEvidence(regular))
+
+	tests := []struct {
+		name   string
+		base   *proof.Proof
+		mutate func(*proof.Proof)
+		err    error
+	}{
+		{
+			name: "old transition", base: regular,
+			mutate: func(p *proof.Proof) {
+				p.Version = proof.TransitionV0
+			},
+			err: proof.ErrTransitionV1Required,
+		},
+		{
+			name: "spender evidence", base: regular,
+			mutate: func(p *proof.Proof) {
+				p.InclusionProof.CommitmentProof.SpenderProofs = nil
+			},
+			err: proof.ErrMissingSpenderProofs,
+		},
+		{
+			name: "split locator", base: split,
+			mutate: func(p *proof.Proof) {
+				p.RootLocatorProof = nil
+			},
+			err: proof.ErrMissingRootLocatorProof,
+		},
+		{
+			name: "split stxo", base: split,
+			mutate: func(p *proof.Proof) {
+				p.SplitRootProof.CommitmentProof.STXOProofs = nil
+			},
+			err: proof.ErrMissingSplitSTXOProofs,
+		},
+		{
+			name: "split spender", base: split,
+			mutate: func(p *proof.Proof) {
+				p.SplitRootProof.CommitmentProof.SpenderProofs = nil
+			},
+			err: proof.ErrMissingSpenderProofs,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			raw, err := test.base.Bytes()
+			require.NoError(t, err)
+			p, err := proof.Decode(raw)
+			require.NoError(t, err)
+			test.mutate(p)
+			require.ErrorIs(t, checkActivationEvidence(p), test.err)
+		})
+	}
+}
