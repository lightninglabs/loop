+			return fmt.Errorf("%s %d: invalid %s: %w", label, i,
+				label, err)
+		}
+		if _, ok := seen[key]; ok {
+			return fmt.Errorf("duplicate %s %d", label, i)
+		}
+		seen[key] = struct{}{}
+	}
+
+	return nil
+}
