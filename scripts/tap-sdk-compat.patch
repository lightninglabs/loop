+package grpc
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	tapsdk "github.com/lightninglabs/tap-sdk"
+	"github.com/lightninglabs/taproot-assets/rpcutils"
+	"github.com/lightninglabs/taproot-assets/taprpc/assetwalletrpc"
+	"github.com/stretchr/testify/require"
+	grpcpkg "google.golang.org/grpc"
+)
+
+type scriptKeyClient struct {
+	assetwalletrpc.AssetWalletClient
+
+	request *assetwalletrpc.DeclareScriptKeyRequest
+}
+
+func (c *scriptKeyClient) DeclareScriptKey(_ context.Context,
+	req *assetwalletrpc.DeclareScriptKeyRequest,
+	_ ...grpcpkg.CallOption) (*assetwalletrpc.DeclareScriptKeyResponse, error) {
+
+	c.request = req
+	return &assetwalletrpc.DeclareScriptKeyResponse{
+		ScriptKey: req.ScriptKey,
+	}, nil
+}
+
+func TestDeclareScriptKeyEncoding(t *testing.T) {
+	t.Parallel()
+
+	key, err := tapsdk.ParsePubKey(testPubKey)
+	require.NoError(t, err)
+	backend := &scriptKeyClient{}
+	client := &walletKitClient{client: backend, timeout: time.Second}
+	_, err = client.DeclareScriptKey(t.Context(), &tapsdk.DeclareScriptKeyRequest{
+		ScriptKey: tapsdk.ScriptKey{
+			PubKey:   key,
+			KeyDesc:  tapsdk.KeyDescriptor{RawKeyBytes: key},
+			TapTweak: make([]byte, 32),
+		},
+	})
+	require.NoError(t, err)
+	require.Equal(t, key[1:], backend.request.ScriptKey.PubKey)
+	require.Equal(t, key[:], backend.request.ScriptKey.KeyDesc.RawKeyBytes)
+	_, err = rpcutils.UnmarshalScriptKey(backend.request.ScriptKey)
+	require.NoError(t, err)
+}
